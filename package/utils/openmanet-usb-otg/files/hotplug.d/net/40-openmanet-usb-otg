#!/bin/sh

# When a USB gadget netdev appears, ensure share_mode wiring is applied.
# rndis-ecm exposes usb0 (RNDIS) and usb1 (ECM); ncm/rndis typically only usb0.

[ "$ACTION" = "add" ] || exit 0
case "$INTERFACE" in
	usb0|usb1) ;;
	*) exit 0 ;;
esac

[ -f /lib/openmanet/usb-otg.sh ] || exit 0
. /lib/openmanet/usb-otg.sh

openmanet_usb_otg_enabled || exit 0
openmanet_usb_otg_apply_network

# Ask netifd to claim the new port / interface.
ubus call network reload 2>/dev/null || true
