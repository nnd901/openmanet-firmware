#!/bin/sh /etc/rc.common

START=20
STOP=90

USE_PROCD=1

. /lib/openmanet/usb-otg.sh

configure_usbgadget() {
	local enabled preset
	local idx

	config_load openmanet_usb_otg
	config_get_bool enabled main enabled 0
	config_get preset main gadget_preset auto
	preset="$(openmanet_usb_otg_resolve_preset "$preset")"

	if [ "$enabled" -ne 1 ]; then
		# Leave usbgadget presets disabled when OTG share is off.
		idx=0
		while uci -q get usbgadget.@preset[$idx] >/dev/null; do
			uci -q delete usbgadget.@preset[$idx].UDC
			idx=$((idx + 1))
		done
		uci -q commit usbgadget
		return 0
	fi

	# Ensure a single gadget preset is present and bound to auto UDC.
	# gadget_preset=auto resolves to rndis-ecm (composite); fixed presets win.
	if ! uci -q get usbgadget.@preset[0] >/dev/null; then
		uci -q add usbgadget preset
	fi
	uci -q set usbgadget.@preset[0].name="$preset"
	uci -q set usbgadget.@preset[0].UDC='auto'
	uci -q commit usbgadget

	# Before the next usbgadget bind: per-board universal host_addr from eth0
	# so Android names the host iface ethN (EthernetTracker) instead of usbN.
	openmanet_usb_otg_assign_universal_macs
}

start_service() {
	# Service (re)start always applies the LuCI/UCI preset resolution; drop any
	# prior Auto FDB-narrow runtime state so we begin from composite again.
	openmanet_usb_otg_narrow_state_set ""

	configure_usbgadget

	# Always restart usbgadget so enable/disable and preset changes take effect
	# (clearing UDC in UCI alone does not tear down an already-attached gadget).
	[ -x /etc/init.d/usbgadget ] && /etc/init.d/usbgadget restart

	openmanet_usb_otg_enabled || return 0

	openmanet_usb_otg_apply_network

	# Reload network so newly bridged usb0/usb1 ports are picked up when present.
	if [ -x /etc/init.d/network ] && \
	   { [ -d /sys/class/net/usb0 ] || [ -d /sys/class/net/usb1 ]; }; then
		ubus call network reload 2>/dev/null || /etc/init.d/network reload
	fi

	# Watch for host disconnect / wedged attach and rebind UDC only (keeps MACs).
	procd_open_instance udc-watch
	procd_set_param command /usr/sbin/openmanet-usb-otg-udc-watch
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	return 0
}

reload_service() {
	start_service
}

service_triggers() {
	procd_add_reload_trigger openmanet_usb_otg usbgadget network
}
