config openmanet_usb_otg 'main'
	option enabled '1'
	# bridge: USB host joins br-lan (WebUI at usual LAN IP; ATAK-friendly)
	# nat: dedicated usb subnet (advanced; WebUI not on the USB subnet by default)
	option share_mode 'bridge'
	# usbgadget preset under /usr/share/usbgadget — v1 default is ncm
	option gadget_preset 'ncm'
	option nat_ip '192.168.42.1'
	option nat_netmask '255.255.255.0'
	option nat_start '100'
	option nat_limit '50'
