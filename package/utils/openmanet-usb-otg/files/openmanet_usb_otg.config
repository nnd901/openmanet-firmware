config openmanet_usb_otg 'main'
	option enabled '1'
	# bridge: add usb0 to br-lan (ATAK/multicast friendly)
	# nat: dedicated usb network with masquerade toward lan/wan
	option share_mode 'bridge'
	# usbgadget preset name under /usr/share/usbgadget (ncm, rndis, rndis-ecm, …)
	option gadget_preset 'ncm'
	option nat_ip '192.168.42.1'
	option nat_netmask '255.255.255.0'
	option nat_start '100'
	option nat_limit '50'
